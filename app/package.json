{
  "name": "monero-autopilot",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:app": "pnpm typecheck && vite build && node scripts/package-app.mjs",
    "build": "pnpm build:app",
    "test:amounts": "node --test tests/receive-amounts.mjs",
    "test:desktop": "node tests/desktop-mainnet-ui.mjs",
    "test:startup": "node tests/mainnet-startup-ui.mjs",
    "test:payments": "node tests/mainnet-payments-ui.mjs",
    "test:setup": "node tests/wallet-setup-pending-ui.mjs",
    "test": "pnpm test:amounts && pnpm test:desktop && pnpm test:startup && pnpm test:payments && pnpm test:setup"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsqr": "1.4.0",
    "openpgp": "^6.3.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
